# The Boss Barber — variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` al repositorio.

# --- PostgreSQL (Neon) ---
# URL de conexión (solo lectura/escritura para la app)
DATABASE_URL=
# URL directa (requerida por Prisma con pooling de Neon)
DIRECT_URL=

# --- Autenticación administrativa ---
# Secreto para firmar los JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=

# Credenciales del admin inicial (se crean al ejecutar la semilla)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Empresa / negocio ---
BUSINESS_NAME=The Boss Barber
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS=
BUSINESS_INSTAGRAM=
BUSINESS_TIMEZONE=America/Bogota

# --- Público ---
# Cualquier cliente puede reservar sin clave pública.
PUBLIC_API_KEY=
